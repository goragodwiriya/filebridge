# FileBridge - keep internals and secrets off the web.
# These rules work whether the app is served from a subdirectory or a domain
# root, and do not depend on per-directory .htaccess files (composer wipes
# vendor/ on every install).

RedirectMatch 404 ^(.*/)?(config|storage|src|vendor)/
RedirectMatch 404 ^(.*/)?worker\.php$
RedirectMatch 404 ^(.*/)?composer\.(json|lock)$
RedirectMatch 404 ^(.*/)?\.git

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_php.c>
    php_value upload_max_filesize 512M
    php_value post_max_size 512M
</IfModule>

Options -Indexes
DirectoryIndex index.php
