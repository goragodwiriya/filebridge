# FileBridge on nginx + php-fpm.
# Adjust `root`, the location prefix and the fastcgi_pass socket to your setup.

server {
    listen 443 ssl http2;
    server_name filebridge.example.com;

    root /var/www/filebridge;
    index index.php;

    ssl_certificate     /etc/ssl/certs/filebridge.crt;
    ssl_certificate_key /etc/ssl/private/filebridge.key;

    client_max_body_size 512M;

    # Internals and secrets must never be served.
    location ~ ^/(config|storage|src|vendor)/ {
        deny all;
        return 404;
    }
    location = /worker.php {
        deny all;
        return 404;
    }
    location ~ /\.(git|env|htaccess) {
        deny all;
        return 404;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;

        # Transfers run in a detached worker, but the browser-driven fallback
        # needs room when proc_open is unavailable.
        fastcgi_read_timeout 300;

        # Optional: keep the master key off a filesystem that ignores chmod.
        # fastcgi_param FILEBRIDGE_KEY_FILE /etc/filebridge/key.php;
    }

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;
}
